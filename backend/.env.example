# Create a .env file in the backend/ directory with these values:
SECRET_KEY=django-insecure-change-this-to-a-real-secret-key-in-production
DEBUG=True
DB_NAME=ai_ecommerce
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
# Set USE_SQLITE=True to use SQLite (no MySQL needed)
# Set USE_SQLITE=False to use MySQL
USE_SQLITE=True
